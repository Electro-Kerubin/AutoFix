{
  "folders": [{ "name": "AutoFix · Angular + NestJS", "path": "." }],
  "settings": {
    "files.exclude": {
      "**/.tools": true,
      "**/dist": true,
      "**/.angular": true,
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.tools": true,
      "**/dist": true,
    },
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "AutoFix: Iniciar",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}/Iniciar-AutoFix.ps1",
        ],
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": [],
      },
      {
        "label": "AutoFix: Compilar Angular",
        "type": "process",
        "command": "${workspaceFolder}/.tools/node_modules/node/bin/node.exe",
        "args": ["node_modules/@angular/cli/bin/ng.js", "build"],
        "options": { "cwd": "${workspaceFolder}/Frontend" },
        "group": "build",
        "problemMatcher": [],
      },
    ],
  },
}
