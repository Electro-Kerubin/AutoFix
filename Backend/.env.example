# ---- Servidor ----
NODE_ENV=development
PORT=3000
# URL pública del sistema (se usa en los links del portal cliente que se envían por WhatsApp)
PUBLIC_URL=http://localhost:4201
# Orígenes CORS separados por coma. En producción (same-origin) dejar vacío.
CORS_ORIGIN=http://localhost:4201
# true si hay un proxy/balanceador delante (para registrar la IP real en las aprobaciones)
TRUST_PROXY=false

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=autofix
DB_PASSWORD=autofix_dev
DB_NAME=autofix
DB_SSL=false
# Sólo desarrollo: true crea/ajusta tablas automáticamente. En producción usar migraciones.
DB_SYNC=true
DB_MIGRATIONS_RUN=false

# ---- Seguridad ----
# Obligatorio en producción (mínimo 32 caracteres). Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=36000

# ---- Archivos ----
UPLOADS_DIR=uploads
FRONTEND_DIST=../Frontend/dist/autofix-frontend/browser

# ---- Tareas periódicas (cola de sincronización, recordatorios) ----
WORKERS_ENABLED=true

# ---- Datos de demostración ----
# Carga sucursales, usuarios y repuestos de ejemplo si la base está vacía (por defecto true fuera de producción)
SEED_ON_BOOT=true

# ---- Integraciones (vacío = sistema externo simulado) ----
ERP_BASE_URL=
ERP_API_KEY=
INVENTARIO_BASE_URL=
INVENTARIO_API_KEY=
